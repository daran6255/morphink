# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL Parameters)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="12345"
DB_NAME="morphink_db"
DB_SCHEMA="public"

# Database Connection URL (Dynamic Variable Expansion from Parameters Above)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# Security & Authentication (High-Entropy Strong JWT Secret Key)
JWT_SECRET="morphink_sec_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1_super_strong_2026_key"
JWT_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins allowed)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:4173"

# File Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="25"
